# ──────────────────────────────────────────────
# SERVER
# Railway inyecta PORT automáticamente — no lo
# configures manualmente en las variables de Railway.
# ──────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ──────────────────────────────────────────────
# DATABASE (Neon PostgreSQL)
# Usa la URL del pooler de Neon para todas las
# operaciones (queries + migraciones).
# ──────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"

# ──────────────────────────────────────────────
# JWT — genera valores aleatorios seguros:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ──────────────────────────────────────────────
JWT_SECRET=replace_with_random_64_char_hex_string
JWT_REFRESH_SECRET=replace_with_another_random_64_char_hex_string

# ──────────────────────────────────────────────
# EMAIL (Resend)
# ──────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=studio@yourdomain.com

# ──────────────────────────────────────────────
# FRONTEND
# FRONTEND_URL → se usa en los links de los emails
#   (verify-email, reset-password). Sin trailing slash.
# CORS_ORIGIN  → origen exacto del frontend para CORS.
#   Solo el scheme + host, sin path ni trailing slash.
#   Acepta múltiples orígenes separados por coma:
#   CORS_ORIGIN=https://tuapp.github.io,http://localhost:3000
# ──────────────────────────────────────────────
FRONTEND_URL=https://username.github.io/Mission-TODO-List
CORS_ORIGIN=https://username.github.io

# ──────────────────────────────────────────────
# RATE LIMITING
# ──────────────────────────────────────────────
AUTH_RATE_LIMIT=10
API_RATE_LIMIT=200
