              "host": ["{{base_url}}"],
              "path": ["api", "v1", "todos", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "TODO_ID_AQUI",
                  "description": "ID de la tarea (cuid)"
                }
              ]
            },
            "description": "Obtiene una tarea por id. Retorna 404 si no existe o pertenece a otro usuario."
          },
          "response": []
