              "mode": "raw",
              "raw": "{\n  \"mission_id\": \"MISSION_ID_AQUI\",\n  \"title\": \"Mi nueva tarea\",\n  \"subtitle\": \"Subtítulo opcional\",\n  \"description\": \"Descripción de la tarea\",\n  \"status\": \"in-progress\",\n  \"type_of_mission\": \"main\",\n  \"due_date\": \"2026-12-31T00:00:00.000Z\",\n  \"objectives\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/todos",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "todos"]
            },
            "description": "Crea una nueva tarea. Devuelve 201 con el objeto completo. Campos requeridos: mission_id, title."
          },
          "response": []
        },
        {
          "name": "GET /todos/:id",
          "request": {
            "method": "GET",
            "header": [],
